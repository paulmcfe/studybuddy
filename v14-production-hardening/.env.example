# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL Database URL (required)
POSTGRES_URL=postgresql://localhost/studybuddy

# Qdrant Vector Database URL (optional, defaults to localhost:6333)
QDRANT_URL=http://localhost:6333

# JWT Authentication (v12)
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============== v13: Multi-Model Infrastructure ==============

# Together AI API Key (optional, for hosted open-source models)
# Sign up at https://together.ai (free credits available)
# Enables: Llama 4, Mixtral, Qwen, and other open models
TOGETHER_API_KEY=your-together-api-key

# Ollama URL (optional, defaults to http://localhost:11434)
# For local development with open-source models
# Start Ollama with: ollama serve
# Pull models with: ollama pull llama3.2
OLLAMA_URL=http://127.0.0.1:11434

# ============== Tracing & Monitoring ==============

# LangSmith Tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=studybuddy-v13
LANGSMITH_API_KEY=your-langsmith-key

# Cohere API Key (optional, for reranking)
COHERE_API_KEY=your-cohere-key-here

# ============== MCP Connectors (v11) ==============

# GitHub Personal Access Token (optional, for GitHub MCP connector)
GITHUB_TOKEN=ghp_your-token-here

# Brave Search API Key (optional, for web search MCP connector)
# Sign up at https://brave.com/search/api/ (free tier: 2000 queries/month)
BRAVE_API_KEY=BSA_your-key-here
